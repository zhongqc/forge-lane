DATABASE_URL=postgresql://forge:forge_local@localhost:55432/forge
APP_URL=http://localhost:5173
PORT=3001
SEED_PASSWORD=
COOKIE_SECURE=false

# GitHub App: private key PEM may use literal \n between lines. Never commit real keys.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Deployment administrator grants installation IDs to specific project UUIDs.
GITHUB_INSTALLATION_PROJECTS={}

# Email mention notifications. Missing host/from leaves inbox usable and marks deliveries SKIPPED.
# SMTP_SECURE=false uses required STARTTLS; true uses implicit TLS (usually port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
