{
  "name": "forge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first engineering workspace",
  "license": "UNLICENSED",
  "author": "Forge contributors",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm db:generate && electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "test": "node scripts/test.mjs",
    "test:desktop": "playwright test",
    "db:generate": "prisma generate --config packages/local-db/prisma.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "package:dir": "pnpm build && electron-builder --dir --mac --arm64 --publish never",
    "package:dmg": "pnpm build && electron-builder --mac dmg --arm64 --publish never",
    "native:electron": "electron-builder install-app-deps",
    "forge": "node packages/cli/src/forge.mjs",
    "prepare": "simple-git-hooks",
    "setup:desktop": "node node_modules/electron/install.js && electron-builder install-app-deps"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.103.1",
    "better-sqlite3": "13.2.0",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@swc/core": "1.15.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "packageManager": "pnpm@11.9.0"
}
